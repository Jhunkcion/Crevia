{
  "kind": "collectionType",
  "collectionName": "team_members",
  "info": {
    "singularName": "team-member",
    "pluralName": "team-members",
    "displayName": "Team Member",
    "description": "Team talents in Studio and Tech divisions"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "role": {
      "type": "string",
      "required": true
    },
    "division": {
      "type": "enumeration",
      "enum": [
        "studio",
        "tech"
      ],
      "required": true
    },
    "bio": {
      "type": "text"
    },
    "photo": {
      "type": "string"
    },
    "works": {
      "type": "json"
    },
    "socials": {
      "type": "json"
    },
    "order": {
      "type": "integer",
      "default": 0
    }
  }
}
